# Valores abaixo são pra rodar local. Em produção (CapRover), configure via
# variáveis de ambiente do app: PORT não precisa ser setado (o Dockerfile já
# fixa 80), COOKIE_SECURE=true, FRONTEND_URL=https://<seu-subdominio>.gustagg.app
# (qualquer *.gustagg.app já é liberado no CORS automaticamente).
DATABASE_URL="postgresql://postgres:root@localhost:5432/createhack?schema=public"
PORT=3000
FRONTEND_URL="http://localhost:5173"
COOKIE_SECURE=false
IMAGEKIT_PUBLIC_KEY="public_xxx"
IMAGEKIT_PRIVATE_KEY="private_xxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
